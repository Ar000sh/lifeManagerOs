# Container env — copy to ".env.docker" and fill in. Do NOT set PROJECT_DIR here
# (the image already sets PROJECT_DIR=/app).

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
ALLOWED_CHAT_ID=0

# Notion internal integration token (starts with ntn_)
NOTION_TOKEN=ntn_replace_with_your_notion_integration_token

# Claude subscription auth for headless use. Generate on your laptop with:
#   claude setup-token
# then paste the resulting token here. (Do NOT set ANTHROPIC_API_KEY — that would
# switch to metered API billing instead of your subscription.)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-replace-with-your-setup-token

# Google Calendar (token-based MCP for server use). These paths are INSIDE the
# container — the secrets/ folder is mounted to /app/secrets by docker-compose.
GOOGLE_OAUTH_CREDENTIALS=/app/secrets/gcp-oauth.keys.json
GOOGLE_CALENDAR_MCP_TOKEN_PATH=/app/secrets/tokens

# Optional model override
# CLAUDE_MODEL=claude-opus-4-8
